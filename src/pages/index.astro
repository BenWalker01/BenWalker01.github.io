---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getImage, Image } from 'astro:assets';
import me from '../assets/me.jpg';
import { projects } from '../data/projects';

// Grab up to 6 photos for the teaser grid
const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/**/*.{jpg,jpeg,png,webp}',
  { eager: true }
);
const teaserPhotos = await Promise.all(
  Object.values(imageFiles).slice(0, 6).map(mod =>
    getImage({ src: mod.default, width: 300, height: 300, format: 'webp', quality: 75, fit: 'cover' })
  )
);

const featuredProjects = projects.filter((project) => project.featured).slice(0, 3);
---

<Layout title="Ben Walker" description="Software engineer & photographer based in the UK.">
  <Nav />

  <main class="flex-1">
    <!-- Hero -->
    <section class="min-h-screen flex flex-col justify-center px-6 max-w-5xl mx-auto pt-24 pb-20 md:pb-0">
      <div class="max-w-2xl">
        <p class="text-violet-400 text-sm font-mono mb-4 tracking-widest uppercase">Hello, I'm</p>
        <h1 class="text-6xl md:text-7xl font-bold text-white tracking-tight mb-6 leading-none">
          Ben<br/>
          <span class="text-zinc-500">Walker</span>
        </h1>
        <p class="text-xl text-zinc-400 leading-relaxed mb-10 max-w-lg">
          Software engineer who builds things and occasionally captures the world through a lens.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a href="/projects" class="inline-flex items-center gap-2 bg-violet-600 hover:bg-violet-500 text-white font-medium px-6 py-3 rounded-xl transition-colors">
            View Projects
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="/photography" class="inline-flex items-center gap-2 border border-zinc-700 hover:border-violet-500/50 text-zinc-300 hover:text-violet-300 font-medium px-6 py-3 rounded-xl transition-all">
            Photography
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </a>
          <a href="/contact" class="text-zinc-500 hover:text-zinc-300 font-medium px-2 py-3 transition-colors text-sm">
            Get in touch →
          </a>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="hidden md:flex absolute bottom-10 left-1/2 -translate-x-1/2 flex-col items-center gap-2 text-zinc-600 animate-bounce">
        <span class="text-xs font-mono tracking-widest uppercase">Scroll</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </div>
    </section>

    <!-- About -->
    <section class="py-24 px-6 max-w-5xl mx-auto border-t border-zinc-800/50">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-3xl font-bold text-white mb-6">About me</h2>
          <div class="space-y-4 text-zinc-400 leading-relaxed">
            <p>
              I'm a developer who likes understanding how things work by building them. My projects span systems programming, simulation, graphics, and aviation software, with a particular enjoyment for Rust and C++ and the occasional rabbit hole into something completely new.
            </p>
            <p>
              When I'm not writing code, I'm usually out with a camera. I shoot a lot of wildlife and aviation photography.
            </p>
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            {['C/C++', 'Rust', 'Python'].map(skill => (
              <span class="text-sm font-mono text-violet-400/80 bg-violet-500/10 px-3 py-1.5 rounded-lg border border-violet-500/20">
                {skill}
              </span>
            ))}
          </div>
        </div>
        <div class="flex justify-center">
          <div class="relative">
            <Image
              src={me}
              alt="Ben Walker portrait"
              width={448}
              height={448}
              class="w-56 h-56 rounded-2xl object-cover border border-zinc-700"
            />
            <div class="absolute -bottom-2 -right-2 w-56 h-56 rounded-2xl border border-violet-500/20 -z-10"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Projects -->
    <section class="py-24 px-6 max-w-5xl mx-auto border-t border-zinc-800/50">
      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-violet-400 text-sm font-mono mb-2 tracking-widest uppercase">Work</p>
          <h2 class="text-3xl font-bold text-white">Featured Projects</h2>
        </div>
        <a href="/projects" class="text-sm text-zinc-400 hover:text-violet-400 transition-colors font-medium">
          View all →
        </a>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredProjects.map(project => (
          <ProjectCard {...project} />
        ))}
      </div>
    </section>

    <!-- Photography Teaser -->
    <section class="py-24 px-6 max-w-5xl mx-auto border-t border-zinc-800/50">
      <div class="rounded-3xl border border-zinc-800 bg-zinc-900/30 overflow-hidden">
        <div class="p-10 md:p-16 flex flex-col md:flex-row items-center gap-8">
          <div class="flex-1">
            <p class="text-violet-400 text-sm font-mono mb-2 tracking-widest uppercase">Also</p>
            <h2 class="text-3xl font-bold text-white mb-4">Photography</h2>
            <p class="text-zinc-400 leading-relaxed mb-6">
              A collection of photos I've taken...
            </p>
            <a href="/photography" class="inline-flex items-center gap-2 text-violet-400 hover:text-violet-300 font-medium transition-colors">
              Open gallery
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
          <div class="grid grid-cols-3 gap-2 w-full md:w-64 shrink-0">
            {teaserPhotos.length > 0
              ? teaserPhotos.map(img => (
                  <div class="aspect-square rounded-lg overflow-hidden border border-zinc-700/50">
                    <img src={img.src} alt="" class="w-full h-full object-cover" loading="lazy" />
                  </div>
                ))
              : [1,2,3,4,5,6].map(() => (
                  <div class="aspect-square rounded-lg bg-zinc-800 border border-zinc-700/50"></div>
                ))
            }
          </div>
        </div>
      </div>
    </section>

        <!-- Blog -->
    <section class="py-24 px-6 max-w-5xl mx-auto border-t border-zinc-800/50">
      <div class="rounded-3xl border border-zinc-800 bg-zinc-900/30 p-10 md:p-16">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-8">
          <div>
            <p class="text-violet-400 text-sm font-mono mb-2 tracking-widest uppercase">Writing</p>
            <h2 class="text-3xl font-bold text-white">Blog</h2>
          </div>
          <a href="/blog" class="text-sm text-zinc-400 hover:text-violet-400 transition-colors font-medium">
            View blog →
          </a>
        </div>
        <div class="rounded-2xl border border-dashed border-zinc-700 bg-zinc-950/40 p-8 text-zinc-400">
          <p class="text-lg font-medium text-zinc-300 mb-2">Nothing here yet.</p>
          <p>I’ll add posts here when I start writing up projects, experiments, and notes.</p>
        </div>
      </div>
    </section>

    <!-- Links / Social -->
    <section class="py-24 px-6 max-w-5xl mx-auto border-t border-zinc-800/50">
      <h2 class="text-2xl font-bold text-white mb-8 text-center">Find me online</h2>
      <div class="flex flex-wrap justify-center gap-6">
        {[
          { label: 'Email', href: 'mailto:me@ben-walker.uk', icon: 'M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z' },
          { label: 'GitHub', href: 'https://github.com/BenWalker01', icon: 'M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z' },
          { label: 'LinkedIn', href: 'https://linkedin.com/in/benwalker', icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z' },
        ].map(({ label, href, icon }) => (
          <a
            href={href}
            target={href.startsWith('mailto') ? undefined : '_blank'}
            rel="noopener noreferrer"
            class="flex items-center gap-3 text-zinc-400 hover:text-violet-400 border border-zinc-800 hover:border-violet-500/40 px-6 py-3 rounded-xl transition-all hover:bg-violet-500/5"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d={icon}/>
            </svg>
            <span class="font-medium">{label}</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-zinc-800/50 py-8 px-6 text-center text-zinc-600 text-sm">
    <p>© {new Date().getFullYear()} Ben Walker · Built with <a href="https://astro.build" class="hover:text-violet-400 transition-colors">Astro</a></p>
  </footer>
</Layout>
