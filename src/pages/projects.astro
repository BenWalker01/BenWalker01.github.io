---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<Layout title="Projects" description="Software projects by Ben Walker.">
  <Nav />
  <main class="flex-1 pt-32 pb-24 px-6 max-w-5xl mx-auto">
    <div class="mb-16">
      <p class="text-violet-400 text-sm font-mono mb-3 tracking-widest uppercase">My Work</p>
      <h1 class="text-5xl font-bold text-white mb-4">Projects</h1>
      <p class="text-zinc-400 text-lg max-w-xl">
        A selection of things I've built. More on GitHub.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map(project => (
        <ProjectCard {...project} />
      ))}
    </div>

    <div class="mt-16 text-center">
      <p class="text-zinc-500 text-sm mb-4">See more on GitHub</p>
      <a
        href="https://github.com/BenWalker01"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 border border-zinc-700 hover:border-violet-500/50 text-zinc-300 hover:text-violet-300 px-6 py-3 rounded-xl transition-all"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        github.com/BenWalker01
      </a>
    </div>
  </main>

  <footer class="border-t border-zinc-800/50 py-8 px-6 text-center text-zinc-600 text-sm">
    <p>© {new Date().getFullYear()} Ben Walker · Built with <a href="https://astro.build" class="hover:text-violet-400 transition-colors">Astro</a></p>
  </footer>
</Layout>
