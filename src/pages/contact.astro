---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout title="Contact" description="Get in touch with Ben Walker.">
  <Nav />
  <main class="flex-1 pt-32 pb-24 px-6 max-w-3xl mx-auto">
    <div class="mb-12">
      <p class="text-violet-400 text-sm font-mono mb-3 tracking-widest uppercase">Say hello</p>
      <h1 class="text-5xl font-bold text-white mb-4">Contact</h1>
      <p class="text-zinc-400 text-lg max-w-md">
        Got a question or want to work together? Get in touch.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-6 mb-16">
      {[
        {
          label: 'Email',
          value: 'me@ben-walker.uk',
          href: 'mailto:me@ben-walker.uk',
          description: 'Send me a message directly.',
          icon: 'M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z',
        },
        {
          label: 'GitHub',
          value: 'github.com/BenWalker01',
          href: 'https://github.com/BenWalker01',
          description: 'Check out my code and open-source work.',
          icon: 'M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z',
        },
        {
          label: 'LinkedIn',
          value: 'linkedin.com/in/-ben-walker',
          href: 'https://www.linkedin.com/in/-ben-walker',
          description: 'Professional profile and career history.',
          icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
        },
      ].map(({ label, value, href, description, icon }) => (
        <a
          href={href}
          target={href.startsWith('mailto') ? undefined : '_blank'}
          rel="noopener noreferrer"
          class="group flex flex-col gap-4 p-6 rounded-2xl border border-zinc-800 bg-zinc-900/30 hover:border-violet-500/40 hover:bg-violet-500/5 transition-all duration-300"
        >
          <div class="flex items-center justify-between">
            <div class="p-2.5 rounded-xl bg-violet-500/10 border border-violet-500/20 text-violet-400">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d={icon}/>
              </svg>
            </div>
            <svg class="w-4 h-4 text-zinc-600 group-hover:text-violet-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </div>
          <div>
            <p class="text-xs text-zinc-500 font-mono mb-1">{label}</p>
            <p class="text-white font-medium mb-1 group-hover:text-violet-300 transition-colors">{value}</p>
            <p class="text-zinc-500 text-sm">{description}</p>
          </div>
        </a>
      ))}
    </div>
  </main>

  <footer class="border-t border-zinc-800/50 py-8 px-6 text-center text-zinc-600 text-sm">
    <p>© {new Date().getFullYear()} Ben Walker · Built with <a href="https://astro.build" class="hover:text-violet-400 transition-colors">Astro</a></p>
  </footer>
</Layout>
