---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';

// image paths in /public/photos/
// width/height help PhotoSwipe display the lightbox at correct aspect ratio
const photos = [
  { src: '/photos/photo-1.jpg', thumb: '/photos/photo-1.jpg', alt: 'Wildlife 1', width: 1600, height: 1067, category: 'Wildlife' },
  { src: '/photos/photo-2.jpg', thumb: '/photos/photo-2.jpg', alt: 'Aviation 1', width: 1600, height: 1067, category: 'Aviation' },
  { src: '/photos/photo-3.jpg', thumb: '/photos/photo-3.jpg', alt: 'Wildlife 2', width: 1600, height: 900, category: 'Wildlife' },
  { src: '/photos/photo-4.jpg', thumb: '/photos/photo-4.jpg', alt: 'Aviation 2', width: 1600, height: 1067, category: 'Aviation' },
  { src: '/photos/photo-5.jpg', thumb: '/photos/photo-5.jpg', alt: 'Wildlife 3', width: 1067, height: 1600, category: 'Wildlife' },
  { src: '/photos/photo-6.jpg', thumb: '/photos/photo-6.jpg', alt: 'Aviation 3', width: 1600, height: 1067, category: 'Aviation' },
  { src: '/photos/photo-7.jpg', thumb: '/photos/photo-7.jpg', alt: 'Wildlife 4', width: 1600, height: 900, category: 'Wildlife' },
  { src: '/photos/photo-8.jpg', thumb: '/photos/photo-8.jpg', alt: 'Aviation 4', width: 1067, height: 1600, category: 'Aviation' },
  { src: '/photos/photo-9.jpg', thumb: '/photos/photo-9.jpg', alt: 'Wildlife 5', width: 1600, height: 1067, category: 'Wildlife' },
];

const categories = ['All', ...new Set(photos.map(p => p.category))];
---

<Layout title="Photography" description="Photography portfolio by Ben Walker.">
  <Nav />
  <main class="flex-1 pt-32 pb-24 px-6 max-w-6xl mx-auto">
    <div class="mb-12">
      <p class="text-violet-400 text-sm font-mono mb-3 tracking-widest uppercase">Portfolio</p>
      <h1 class="text-5xl font-bold text-white mb-4">Photography</h1>
      <p class="text-zinc-400 text-lg max-w-xl">
        Wildlife and aviation photography. Click any image to open it full screen.
      </p>
    </div>

    <!-- Category filter -->
    <div id="filters" class="flex flex-wrap gap-3 mb-10">
      {categories.map((cat, i) => (
        <button
          data-filter={cat}
          class={`filter-btn text-sm font-medium px-4 py-2 rounded-full border transition-all ${i === 0 ? 'bg-violet-600 border-violet-600 text-white active' : 'border-zinc-700 text-zinc-400 hover:border-violet-500/50 hover:text-zinc-200'}`}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Gallery -->
    <div id="gallery" class="columns-1 sm:columns-2 lg:columns-3 gap-4 space-y-4">
      {photos.map((photo, i) => (
        <a
          href={photo.src}
          data-pswp-width={photo.width}
          data-pswp-height={photo.height}
          data-category={photo.category}
          class="gallery-item group relative block overflow-hidden rounded-xl bg-zinc-800 border border-zinc-700/50 hover:border-violet-500/40 transition-all duration-300 break-inside-avoid"
          target="_blank"
        >
          <div class="aspect-[4/3] bg-zinc-800 flex items-center justify-center relative overflow-hidden">
            <img
              src={photo.thumb}
              alt={photo.alt}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
              onerror="this.parentElement.classList.add('img-error')"
            />
            <!-- Placeholder shown when image is missing -->
            <div class="placeholder-overlay absolute inset-0 flex flex-col items-center justify-center text-zinc-600 opacity-0">
              <svg class="w-10 h-10 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <span class="text-xs">{photo.alt}</span>
            </div>
            <!-- Hover overlay -->
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-all duration-300 flex items-center justify-center">
              <svg class="w-8 h-8 text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
              </svg>
            </div>
          </div>
          <div class="absolute top-3 left-3">
            <span class="text-xs font-medium bg-black/50 backdrop-blur-sm text-zinc-300 px-2 py-1 rounded-full">
              {photo.category}
            </span>
          </div>
        </a>
      ))}
    </div>
  </main>

  <footer class="border-t border-zinc-800/50 py-8 px-6 text-center text-zinc-600 text-sm">
    <p>© {new Date().getFullYear()} Ben Walker · Built with <a href="https://astro.build" class="hover:text-violet-400 transition-colors">Astro</a></p>
  </footer>
</Layout>

<style>
  .img-error .placeholder-overlay {
    opacity: 1;
  }
  .img-error img {
    opacity: 0;
  }

  .gallery-item.hidden {
    display: none;
  }

  /* PhotoSwipe default styles */
  :root {
    --pswp-bg: #09090b;
  }
</style>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '#gallery',
    children: 'a.gallery-item:not(.hidden)',
    pswpModule: () => import('photoswipe'),
    bgOpacity: 0.95,
    showHideAnimationType: 'zoom',
    padding: { top: 20, bottom: 20, left: 20, right: 20 },
  });

  lightbox.init();

  // Category filtering
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.gallery-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter!;

      filterBtns.forEach(b => {
        b.classList.remove('bg-violet-600', 'border-violet-600', 'text-white', 'active');
        b.classList.add('border-zinc-700', 'text-zinc-400');
      });
      btn.classList.add('bg-violet-600', 'border-violet-600', 'text-white', 'active');
      btn.classList.remove('border-zinc-700', 'text-zinc-400');

      items.forEach(item => {
        const cat = item.dataset.category!;
        if (filter === 'All' || cat === filter) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });

      // Reinitialise lightbox after filtering so it picks up visible items
      lightbox.destroy();
      const newLightbox = new PhotoSwipeLightbox({
        gallery: '#gallery',
        children: 'a.gallery-item:not(.hidden)',
        pswpModule: () => import('photoswipe'),
        bgOpacity: 0.95,
        showHideAnimationType: 'zoom',
        padding: { top: 20, bottom: 20, left: 20, right: 20 },
      });
      newLightbox.init();
    });
  });
</script>
