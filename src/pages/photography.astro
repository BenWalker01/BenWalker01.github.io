---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { Image, getImage } from 'astro:assets';
import photoCatalog from '../data/photo-catalog.json';
import timelineConfig from '../data/timeline-events.json';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/**/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

interface PhotoCatalogEntry {
  category: string;
  date: string;
  project: string;
  location: string;
  camera: string;
  lens: string;
  focalLength: string;
  aperture: string;
  shutter: string;
  iso: string;
}

interface NamedEventConfig {
  displayName: string;
  description: string;
  tags: string[];
}

interface GearEvent {
  date: string;
  name: string;
  description: string;
  icon: string;
}

const catalogMap = photoCatalog as Record<string, PhotoCatalogEntry>;
const namedEvents = timelineConfig.namedEvents as Record<string, NamedEventConfig>;
const gearEvents = timelineConfig.gearEvents as GearEvent[];

function labelFromIso(iso: string) {
  const ts = Date.parse(`${iso}T00:00:00Z`);
  if (Number.isNaN(ts)) return 'Unknown date';
  return new Date(ts).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}

function monthYearFromIso(iso: string) {
  const ts = Date.parse(`${iso}T00:00:00Z`);
  if (Number.isNaN(ts)) return '';
  return new Date(ts).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
}

const photos = await Promise.all(
  Object.entries(imageFiles).map(async ([filePath, mod]) => {
    const image = mod.default;
    const filename = filePath.split('/').pop()!;
    const fallbackPrefix = filename.split('-')[0];
    const fallbackCategory = fallbackPrefix.charAt(0).toUpperCase() + fallbackPrefix.slice(1);
    const catalog = catalogMap[filename];
    const date = catalog?.date ?? '';
    const dateTs = Number.isNaN(Date.parse(`${date}T00:00:00Z`)) ? 0 : Date.parse(`${date}T00:00:00Z`);
    const dateLabel = dateTs ? new Date(dateTs).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : 'Unknown date';
    const category = catalog?.category ?? fallbackCategory;

    const display = await getImage({ src: image, width: 2000, format: 'webp', quality: 85 });

    return {
      image,
      src: display.src,
      alt: filename.replace(/\.[^.]+$/, '').replace(/-/g, ' '),
      filename,
      width: display.attributes.width ?? image.width,
      height: display.attributes.height ?? image.height,
      category,
      dateTs,
      dateLabel,
      date,
      project: catalog?.project ?? 'Photo Collection',
      location: catalog?.location ?? 'Unknown',
      camera: catalog?.camera ?? 'Unknown',
      lens: catalog?.lens ?? 'Unknown',
      focalLength: catalog?.focalLength ?? 'Unknown',
      aperture: catalog?.aperture ?? 'Unknown',
      shutter: catalog?.shutter ?? 'Unknown',
      iso: catalog?.iso ?? 'Unknown',
    };
  })
);

photos.sort((a, b) => b.dateTs - a.dateTs || a.alt.localeCompare(b.alt));

const isNamedProject = (project: string) => Boolean(namedEvents[project]);
const namedPhotos = photos.filter((photo) => isNamedProject(photo.project));
const genericPhotos = photos.filter((photo) => !isNamedProject(photo.project));

const namedProjectGroupMap = namedPhotos.reduce((acc, photo) => {
  const key = photo.project;
  if (!acc.has(key)) acc.set(key, []);
  acc.get(key)!.push(photo);
  return acc;
}, new Map<string, typeof photos>());

const genericDateGroupMap = genericPhotos.reduce((acc, photo) => {
  const key = photo.date || 'unknown-date';
  if (!acc.has(key)) acc.set(key, []);
  acc.get(key)!.push(photo);
  return acc;
}, new Map<string, typeof photos>());

interface PhotoGroup {
  type: 'photo-group';
  project: string;
  date: string;
  dateTs: number;
  dateLabel: string;
  monthYear: string;
  location: string;
  category: string;
  photos: typeof photos;
  named: NamedEventConfig | null;
}

interface GearEntry {
  type: 'gear';
  date: string;
  dateTs: number;
  dateLabel: string;
  monthYear: string;
  name: string;
  description: string;
  icon: string;
}

type TimelineEntry = PhotoGroup | GearEntry;

const namedPhotoGroups: PhotoGroup[] = Array.from(namedProjectGroupMap.entries()).map(([project, groupPhotos]) => {
  const sorted = [...groupPhotos].sort((a, b) => b.dateTs - a.dateTs);
  const earliest = [...groupPhotos].sort((a, b) => a.dateTs - b.dateTs)[0];
  const locations = [...new Set(groupPhotos.map((p) => p.location).filter((l) => l !== 'Unknown'))];
  return {
    type: 'photo-group' as const,
    project,
    date: earliest?.date ?? '',
    dateTs: earliest?.dateTs ?? 0,
    dateLabel: earliest?.dateTs ? labelFromIso(earliest.date) : 'Unknown date',
    monthYear: earliest?.date ? monthYearFromIso(earliest.date) : '',
    location: locations.length === 1 ? locations[0] : locations.length > 1 ? 'Multiple locations' : 'Unknown',
    category: sorted[0]?.category ?? 'Unknown',
    photos: sorted,
    named: namedEvents[project] ?? null,
  };
});

const genericPhotoGroups: PhotoGroup[] = Array.from(genericDateGroupMap.entries()).map(([dateKey, groupPhotos]) => {
  const sorted = [...groupPhotos].sort((a, b) => b.dateTs - a.dateTs || a.alt.localeCompare(b.alt));
  const first = sorted[0];
  const locations = [...new Set(groupPhotos.map((p) => p.location).filter((l) => l !== 'Unknown'))];
  const categories = [...new Set(groupPhotos.map((p) => p.category))];
  const categoryLabel = categories.length <= 1 ? (categories[0] ?? 'Unknown') : `${categories[0]} +${categories.length - 1}`;

  return {
    type: 'photo-group' as const,
    project: first?.project ?? 'Photo Collection',
    date: dateKey,
    dateTs: first?.dateTs ?? 0,
    dateLabel: first?.dateTs ? labelFromIso(dateKey) : 'Unknown date',
    monthYear: first?.dateTs ? monthYearFromIso(dateKey) : '',
    location: locations.length === 1 ? locations[0] : locations.length > 1 ? 'Multiple locations' : 'Unknown',
    category: categoryLabel,
    photos: sorted,
    named: null,
  };
});

const gearEntries: GearEntry[] = gearEvents.map((g) => {
  const dateTs = Date.parse(`${g.date}T00:00:00Z`);
  return {
    type: 'gear' as const,
    date: g.date,
    dateTs: Number.isNaN(dateTs) ? 0 : dateTs,
    dateLabel: Number.isNaN(dateTs) ? 'Unknown date' : labelFromIso(g.date),
    monthYear: Number.isNaN(dateTs) ? '' : monthYearFromIso(g.date),
    name: g.name,
    description: g.description,
    icon: g.icon,
  };
});

const timelineEntries: TimelineEntry[] = [...namedPhotoGroups, ...genericPhotoGroups, ...gearEntries].sort(
  (a, b) => b.dateTs - a.dateTs
);

// Track month labels for year/month separators
const seenMonths = new Set<string>();
---


<Layout title="Photography" description="Photography portfolio by Ben Walker.">
  <Nav />
  <main class="flex-1 pt-32 pb-24 px-6 max-w-4xl mx-auto">
    <div class="mb-16">
      <p class="text-violet-400 text-sm font-mono mb-3 tracking-widest uppercase">Portfolio</p>
      <h1 class="text-5xl font-bold text-white mb-4">Photography</h1>
      <p class="text-zinc-400 text-lg max-w-2xl">
        A timeline of shoots, events, and gear - everything from the catalogue.
      </p>
    </div>

    {photos.length === 0 ? (
      <div class="rounded-2xl border border-zinc-800 bg-zinc-900/30 p-12 text-center">
        <p class="text-zinc-500 mb-2">No photos yet</p>
        <p class="text-zinc-600 text-sm">Add images to <code class="text-zinc-500 font-mono">src/assets/photos/</code></p>
      </div>
    ) : (
      <>
        <div class="mb-8">
          <p class="text-xs uppercase tracking-wide text-zinc-500 mb-2">View</p>
          <div class="inline-flex rounded-xl border border-zinc-700 p-1 bg-zinc-900/40">
            <button
              id="timeline-view-btn"
              type="button"
              class="view-toggle-btn active rounded-lg px-4 py-2 text-sm font-medium bg-violet-600 text-white transition-colors"
            >
              Timeline
            </button>
            <button
              id="gallery-view-btn"
              type="button"
              class="view-toggle-btn rounded-lg px-4 py-2 text-sm font-medium text-zinc-300 hover:text-white transition-colors"
            >
              Gallery
            </button>
          </div>
        </div>

        <div id="gallery" class="relative">
          <section id="timeline-view" class="view-pane relative">
            {/* Vertical timeline spine */}
            <div class="absolute left-[7px] top-0 bottom-0 w-px bg-zinc-800 pointer-events-none" aria-hidden="true"></div>

            <div class="space-y-16">
          {timelineEntries.map((entry) => {
            const isNewMonth = !seenMonths.has(entry.monthYear);
            if (entry.monthYear) seenMonths.add(entry.monthYear);

            return (
              <div>
                {/* Month separator */}
                {isNewMonth && entry.monthYear && (
                  <div class="flex items-center gap-4 mb-8 -ml-0.5">
                    <div class="w-3.5 h-3.5 rounded-full bg-zinc-700 border-2 border-zinc-950 flex-shrink-0 z-10"></div>
                    <span class="text-xs font-mono tracking-widest uppercase text-zinc-500">{entry.monthYear}</span>
                  </div>
                )}

                {entry.type === 'gear' ? (
                  /* Gear milestone */
                  <div class="flex gap-6 ml-7">
                    <div class="flex-shrink-0 mt-1 w-8 h-8 rounded-full bg-amber-500/10 border border-amber-500/30 flex items-center justify-center">
                      <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
                      </svg>
                    </div>
                    <div class="flex-1 border border-amber-500/20 bg-amber-500/5 rounded-2xl p-5">
                      <p class="text-xs font-mono tracking-wider text-amber-400 uppercase mb-1">Gear · {entry.dateLabel}</p>
                      <h3 class="text-white font-semibold text-lg mb-1">{entry.name}</h3>
                      <p class="text-zinc-400 text-sm">{entry.description}</p>
                    </div>
                  </div>
                ) : entry.named ? (
                  /* Named event - prominent header + photo grid */
                  <div class="ml-7 space-y-5">
                    <div class="border border-violet-500/30 bg-violet-500/5 rounded-2xl overflow-hidden">
                      {/* Cover strip */}
                      {entry.photos.length > 0 && (
                        <div class="grid grid-cols-4 h-40 overflow-hidden">
                          {entry.photos.slice(0, 4).map((photo) => (
                            <div class="overflow-hidden">
                              <Image
                                src={photo.image}
                                width={400}
                                format="webp"
                                quality={70}
                                alt={photo.alt}
                                class="w-full h-full object-cover"
                                loading="lazy"
                              />
                            </div>
                          ))}
                        </div>
                      )}
                      <div class="p-5">
                        <div class="flex flex-wrap items-start justify-between gap-3 mb-2">
                          <div>
                            <p class="text-xs font-mono tracking-wider text-violet-400 uppercase mb-1">Event · {entry.dateLabel}</p>
                            <h2 class="text-white font-bold text-2xl">{entry.named.displayName}</h2>
                          </div>
                          <div class="flex flex-wrap gap-2">
                            {entry.named.tags.map((tag) => (
                              <span class="text-xs border border-violet-500/40 text-violet-300 rounded-full px-2.5 py-1">{tag}</span>
                            ))}
                          </div>
                        </div>
                        <p class="text-zinc-400 text-sm mb-3">{entry.named.description}</p>
                        <p class="text-xs text-zinc-500">{entry.location} · {entry.photos.length} photos</p>
                      </div>
                    </div>

                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-1.5">
                      {entry.photos.map((photo, idx) => (
                        <a
                          href={photo.src}
                          data-pswp-width={photo.width}
                          data-pswp-height={photo.height}
                          data-category={photo.category}
                          data-camera={photo.camera}
                          data-lens={photo.lens}
                          data-location={photo.location}
                          data-date={photo.dateLabel}
                          data-iso={photo.iso}
                          data-shutter={photo.shutter}
                          data-aperture={photo.aperture}
                          data-focal-length={photo.focalLength}
                          data-filename={photo.filename}
                          class="gallery-item group relative block aspect-square overflow-hidden rounded-xl border border-zinc-800 hover:border-violet-500/40 transition-all duration-300"
                        >
                          <Image
                            src={photo.image}
                            width={600}
                            format="webp"
                            quality={80}
                            alt={photo.alt}
                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                            loading={idx < 6 ? 'eager' : 'lazy'}
                          />
                          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-all duration-300 flex items-center justify-center">
                            <svg class="w-6 h-6 text-white opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
                            </svg>
                          </div>
                        </a>
                      ))}
                    </div>
                  </div>
                ) : (
                  /* Generic photo group - compact date row */
                  <div class="ml-7 space-y-4">
                    <div class="flex items-center gap-3">
                      <div>
                        <span class="text-sm text-zinc-300 font-medium">{entry.dateLabel}</span>
                        <span class="text-zinc-600 mx-2">·</span>
                        <span class="text-sm text-zinc-500">{entry.category}</span>
                        <span class="text-zinc-600 mx-2">·</span>
                        <span class="text-xs text-zinc-600">{entry.photos.length} photos</span>
                      </div>
                    </div>

                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-1.5">
                      {entry.photos.map((photo, idx) => (
                        <a
                          href={photo.src}
                          data-pswp-width={photo.width}
                          data-pswp-height={photo.height}
                          data-category={photo.category}
                          data-camera={photo.camera}
                          data-lens={photo.lens}
                          data-location={photo.location}
                          data-date={photo.dateLabel}
                          data-iso={photo.iso}
                          data-shutter={photo.shutter}
                          data-aperture={photo.aperture}
                          data-focal-length={photo.focalLength}
                          data-filename={photo.filename}
                          class="gallery-item group relative block aspect-square overflow-hidden rounded-xl border border-zinc-800 hover:border-violet-500/40 transition-all duration-300"
                        >
                          <Image
                            src={photo.image}
                            width={500}
                            format="webp"
                            quality={80}
                            alt={photo.alt}
                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                            loading={idx < 8 ? 'eager' : 'lazy'}
                          />
                          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-all duration-300 flex items-center justify-center">
                            <svg class="w-6 h-6 text-white opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
                            </svg>
                          </div>
                        </a>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            );
          })}
          </div>
        </section>

        <section id="classic-gallery-view" class="view-pane hidden">
          <div id="classic-gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-5 gap-y-3 auto-rows-[6px]">
            {photos.map((photo, idx) => (
              <a
                href={photo.src}
                data-pswp-width={photo.width}
                data-pswp-height={photo.height}
                data-category={photo.category}
                data-camera={photo.camera}
                data-lens={photo.lens}
                data-location={photo.location}
                data-date={photo.dateLabel}
                data-iso={photo.iso}
                data-shutter={photo.shutter}
                data-aperture={photo.aperture}
                data-focal-length={photo.focalLength}
                data-filename={photo.filename}
                class="gallery-item masonry-item group relative block overflow-hidden rounded-xl border border-zinc-800 hover:border-violet-500/40 transition-all duration-300"
              >
                <div class="masonry-content relative overflow-hidden">
                  <Image
                    src={photo.image}
                    width={900}
                    format="webp"
                    quality={80}
                    alt={photo.alt}
                    class="block w-full h-auto object-cover transition-transform duration-500 group-hover:scale-105"
                    loading={idx < 12 ? 'eager' : 'lazy'}
                  />
                  <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-all duration-300 flex items-center justify-center">
                    <svg class="w-6 h-6 text-white opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
                    </svg>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      </div>
      </>
    )}
  </main>

  <footer class="border-t border-zinc-800/50 py-8 px-6 text-center text-zinc-600 text-sm">
    <p>© {new Date().getFullYear()} Ben Walker · Built with <a href="https://astro.build" class="hover:text-violet-400 transition-colors">Astro</a></p>
  </footer>
</Layout>

<style>
  :global(.pswp__button--settings-toggle) {
    width: auto;
    min-width: 148px;
    min-height: 44px;
    color: #ffffff;
    border: 1px solid rgba(139, 92, 246, 0.9);
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 10px 16px;
    margin: 0;
    background: linear-gradient(135deg, #7c3aed, #8b5cf6);
    box-shadow: 0 6px 18px rgba(124, 58, 237, 0.45);
    position: absolute;
    top: 14px;
    right: 64px;
    z-index: 30;
  }

  :global(.pswp__button--settings-toggle:hover) {
    color: #ffffff;
    border-color: #c4b5fd;
    filter: brightness(1.08);
  }

  :global(.pswp__button--zoom) {
    display: none !important;
  }

  :global(.pswp__custom-settings) {
    position: absolute;
    right: 16px;
    bottom: 16px;
    width: min(360px, calc(100vw - 32px));
    border: 1px solid #3f3f46;
    border-radius: 14px;
    background: rgba(9, 9, 11, 0.92);
    color: #e4e4e7;
    backdrop-filter: blur(8px);
    padding: 12px;
    line-height: 1.4;
  }

  :global(.pswp__custom-settings[hidden]) {
    display: none !important;
  }

  :global(.pswp__custom-settings h4) {
    margin: 0 0 8px;
    color: #c4b5fd;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  :global(.pswp__custom-settings ul) {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  :global(.pswp__custom-settings li) {
    background: rgba(39, 39, 42, 0.55);
    border: 1px solid rgba(82, 82, 91, 0.8);
    border-radius: 10px;
    padding: 8px;
  }

  :global(.pswp__custom-settings strong) {
    display: block;
    color: #a1a1aa;
    font-size: 11px;
    margin-bottom: 4px;
    font-weight: 500;
  }

  :global(.pswp__custom-settings span) {
    font-size: 13px;
    color: #f4f4f5;
  }
</style>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import PhotoSwipe from 'photoswipe';
  import 'photoswipe/style.css';

  let settingsOpen = false;

  function getSlideMeta(pswp) {
    const el = pswp?.currSlide?.data?.element;
    if (!el) return null;
    return {
      location: el.dataset.location || 'Unknown',
      date: el.dataset.date || 'Unknown',
      camera: el.dataset.camera || 'Unknown',
      lens: el.dataset.lens || 'Unknown',
      focalLength: el.dataset.focalLength || 'Unknown',
      aperture: el.dataset.aperture || 'Unknown',
      shutter: el.dataset.shutter || 'Unknown',
      iso: el.dataset.iso || 'Unknown',
    };
  }

  function renderSettings(pswp) {
    const panel = pswp?.element?.querySelector('.pswp__custom-settings');
    const toggleButton = pswp?.element?.querySelector('.pswp__button--settings-toggle');
    if (!panel || !toggleButton) return;

    toggleButton.setAttribute('aria-pressed', String(settingsOpen));
    panel.hidden = !settingsOpen;

    if (!settingsOpen) return;

    const meta = getSlideMeta(pswp);
    if (!meta) return;

    const escapeHtml = (value) =>
      String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

    panel.innerHTML = `
      <h4>Photo settings</h4>
      <ul>
        <li><strong>Date</strong><span>${escapeHtml(meta.date)}</span></li>
        <li><strong>Location</strong><span>${escapeHtml(meta.location)}</span></li>
        <li><strong>Camera</strong><span>${escapeHtml(meta.camera)}</span></li>
        <li><strong>Lens</strong><span>${escapeHtml(meta.lens)}</span></li>
        <li><strong>Focal Length</strong><span>${escapeHtml(meta.focalLength)}</span></li>
        <li><strong>Aperture</strong><span>${escapeHtml(meta.aperture)}</span></li>
        <li><strong>Shutter</strong><span>${escapeHtml(meta.shutter)}</span></li>
        <li><strong>ISO</strong><span>${escapeHtml(meta.iso)}</span></li>
      </ul>
    `;
  }

  function initLightbox() {
    const instance = new PhotoSwipeLightbox({
      gallery: '#gallery',
      children: '.view-pane:not(.hidden) a.gallery-item',
      pswpModule: PhotoSwipe,
      bgOpacity: 0.95,
      showHideAnimationType: 'zoom',
      padding: { top: 20, bottom: 20, left: 20, right: 20 },
    });

    instance.on('uiRegister', () => {
      instance.pswp.ui.registerElement({
        name: 'settings-toggle',
        order: 8,
        isButton: true,
        tagName: 'button',
        html: 'Photo settings',
        className: 'pswp__button--settings-toggle',
        onClick: (_event, _el, pswp) => {
          settingsOpen = !settingsOpen;
          renderSettings(pswp);
        },
      });

      instance.pswp.ui.registerElement({
        name: 'settings-panel',
        order: 9,
        appendTo: 'root',
        className: 'pswp__custom-settings',
        html: '',
        onInit: (el, pswp) => {
          el.hidden = true;
          renderSettings(pswp);
        },
      });
    });

    instance.on('change', () => {
      renderSettings(instance.pswp);
    });

    instance.on('close', () => {
      settingsOpen = false;
    });

    return instance;
  }

  const timelineViewBtn = document.getElementById('timeline-view-btn');
  const galleryViewBtn = document.getElementById('gallery-view-btn');
  const timelineView = document.getElementById('timeline-view');
  const classicGalleryView = document.getElementById('classic-gallery-view');
  const classicGalleryGrid = document.getElementById('classic-gallery-grid');

  function layoutClassicMasonry() {
    if (!classicGalleryView || !classicGalleryGrid || classicGalleryView.classList.contains('hidden')) return;

    const styles = getComputedStyle(classicGalleryGrid);
    const rowHeight = parseFloat(styles.getPropertyValue('grid-auto-rows'));
    const rowGap = parseFloat(styles.getPropertyValue('row-gap'));
    if (!rowHeight || Number.isNaN(rowHeight)) return;

    const items = classicGalleryGrid.querySelectorAll('.masonry-item');
    items.forEach((item) => {
      const content = item.querySelector('.masonry-content');
      if (!content) return;
      const height = content.getBoundingClientRect().height;
      const span = Math.ceil((height + rowGap) / (rowHeight + rowGap));
      item.style.gridRowEnd = `span ${span}`;
    });
  }

  function setView(mode) {
    if (!timelineViewBtn || !galleryViewBtn || !timelineView || !classicGalleryView) return;
    const showTimeline = mode === 'timeline';

    timelineView.classList.toggle('hidden', !showTimeline);
    classicGalleryView.classList.toggle('hidden', showTimeline);

    timelineViewBtn.classList.toggle('bg-violet-600', showTimeline);
    timelineViewBtn.classList.toggle('text-white', showTimeline);
    timelineViewBtn.classList.toggle('active', showTimeline);
    timelineViewBtn.classList.toggle('text-zinc-300', !showTimeline);

    galleryViewBtn.classList.toggle('bg-violet-600', !showTimeline);
    galleryViewBtn.classList.toggle('text-white', !showTimeline);
    galleryViewBtn.classList.toggle('active', !showTimeline);
    galleryViewBtn.classList.toggle('text-zinc-300', showTimeline);

    if (!showTimeline) {
      requestAnimationFrame(layoutClassicMasonry);
    }
  }

  timelineViewBtn?.addEventListener('click', () => setView('timeline'));
  galleryViewBtn?.addEventListener('click', () => setView('gallery'));

  document.querySelectorAll('#classic-gallery-view img').forEach((img) => {
    if (!img.complete) {
      img.addEventListener('load', () => {
        requestAnimationFrame(layoutClassicMasonry);
      });
    }
  });

  window.addEventListener('resize', () => {
    requestAnimationFrame(layoutClassicMasonry);
  });

  setView('timeline');

  const lightbox = initLightbox();
  lightbox.init();
</script>
