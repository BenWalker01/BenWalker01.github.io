---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { getImage } from 'astro:assets';
import photoDates from '../data/photo-dates.json';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/**/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const dateMap = photoDates as Record<string, string>;

const photos = await Promise.all(
  Object.entries(imageFiles).map(async ([filePath, mod]) => {
    const image = mod.default;
    const filename = filePath.split('/').pop()!;
    const date = dateMap[filename] ?? '';
    const dateTs = Number.isNaN(Date.parse(`${date}T00:00:00Z`)) ? 0 : Date.parse(`${date}T00:00:00Z`);

    const prefix = filename.split('-')[0];
    const category = prefix.charAt(0).toUpperCase() + prefix.slice(1);

    const [thumb, display] = await Promise.all([
      getImage({ src: image, width: 800, format: 'webp', quality: 80 }),
      getImage({ src: image, width: 2000, format: 'webp', quality: 85 }),
    ]);

    return {
      thumb: thumb.src,
      src: display.src,
      alt: filename.replace(/\.[^.]+$/, '').replace(/-/g, ' '),
      width: display.attributes.width ?? image.width,
      height: display.attributes.height ?? image.height,
      category,
      dateTs,
    };
  })
);

// Newest first
photos.sort((a, b) => b.dateTs - a.dateTs || a.alt.localeCompare(b.alt));

const categories = ['All', ...new Set(photos.map((p) => p.category))];
---

<Layout title="Photography" description="Photography portfolio by Ben Walker.">
  <Nav />
  <main class="flex-1 pt-32 pb-24 px-6 max-w-6xl mx-auto">
    <div class="mb-12">
      <p class="text-violet-400 text-sm font-mono mb-3 tracking-widest uppercase">Portfolio</p>
      <h1 class="text-5xl font-bold text-white mb-4">Photography</h1>
      <p class="text-zinc-400 text-lg max-w-xl">
        Wildlife and aviation photography. Click any image to open it full screen.
      </p>
    </div>

    {photos.length === 0 ? (
      <div class="rounded-2xl border border-zinc-800 bg-zinc-900/30 p-12 text-center">
        <svg class="w-12 h-12 text-zinc-700 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <p class="text-zinc-500 mb-2">No photos yet</p>
        <p class="text-zinc-600 text-sm">Add images to <code class="text-zinc-500 font-mono">src/assets/photos/</code> named like <code class="text-zinc-500 font-mono">wildlife-red-kite.jpg</code></p>
      </div>
    ) : (
      <>
        <div id="filters" class="flex flex-wrap gap-3 mb-10">
          {categories.map((cat, i) => (
            <button
              data-filter={cat}
              class={`filter-btn text-sm font-medium px-4 py-2 rounded-full border transition-all ${i === 0 ? 'bg-violet-600 border-violet-600 text-white active' : 'border-zinc-700 text-zinc-400 hover:border-violet-500/50 hover:text-zinc-200'}`}
            >
              {cat}
            </button>
          ))}
        </div>

        <div class="relative">
          <div id="gallery" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-0.5 auto-rows-[2px]">
            {photos.map((photo, index) => (
              <a
                href={photo.src}
                data-pswp-width={photo.width}
                data-pswp-height={photo.height}
                data-category={photo.category}
                data-index={index}
                class="gallery-item masonry-item group relative block overflow-hidden rounded-xl border border-zinc-700/50 hover:border-violet-500/40 transition-all duration-300"
              >
                <div class="masonry-content relative overflow-hidden">
                  <img
                    src={photo.thumb}
                    alt={photo.alt}
                    class="block w-full h-auto object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-all duration-300 flex items-center justify-center">
                    <svg class="w-8 h-8 text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
                    </svg>
                  </div>
                </div>
                <div class="absolute top-3 left-3">
                  <span class="text-xs font-medium bg-black/50 backdrop-blur-sm text-zinc-300 px-2 py-1 rounded-full">
                    {photo.category}
                  </span>
                </div>
              </a>
            ))}
          </div>

          <div
            id="gallery-fade"
            class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-b from-transparent to-zinc-950 transition-opacity duration-300"
          ></div>
        </div>

        <div class="mt-10 text-center">
          <button
            id="show-more-btn"
            type="button"
            class="inline-flex items-center gap-2 border border-zinc-700 hover:border-violet-500/50 text-zinc-300 hover:text-violet-300 font-medium px-6 py-3 rounded-xl transition-all"
          >
            Show more
          </button>
        </div>
      </>
    )}
  </main>

  <footer class="border-t border-zinc-800/50 py-8 px-6 text-center text-zinc-600 text-sm">
    <p>© {new Date().getFullYear()} Ben Walker · Built with <a href="https://astro.build" class="hover:text-violet-400 transition-colors">Astro</a></p>
  </footer>
</Layout>

<style>
  .gallery-item.hidden {
    display: none;
  }

  :root {
    --pswp-bg: #09090b;
  }
</style>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import PhotoSwipe from 'photoswipe';
  import 'photoswipe/style.css';

  function initLightbox() {
    return new PhotoSwipeLightbox({
      gallery: '#gallery',
      children: 'a.gallery-item:not(.hidden)',
      pswpModule: PhotoSwipe,
      bgOpacity: 0.95,
      showHideAnimationType: 'zoom',
      padding: { top: 20, bottom: 20, left: 20, right: 20 },
    });
  }

  let lightbox = initLightbox();
  lightbox.init();

  const gallery = document.getElementById('gallery');
  const galleryFade = document.getElementById('gallery-fade');
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.gallery-item');
  const images = document.querySelectorAll<HTMLImageElement>('#gallery img');
  const showMoreBtn = document.getElementById('show-more-btn') as HTMLButtonElement | null;
  const PAGE_SIZE = 12;
  let activeFilter = 'All';

  function itemMatchesFilter(item: HTMLElement) {
    const cat = item.dataset.category!;
    return activeFilter === 'All' || cat === activeFilter;
  }

  function refreshLightbox() {
    lightbox.destroy();
    lightbox = initLightbox();
    lightbox.init();
  }

  function layoutMasonry() {
    if (!gallery) return;
    const styles = getComputedStyle(gallery);
    const rowHeight = parseFloat(styles.getPropertyValue('grid-auto-rows'));
    const rowGap = parseFloat(styles.getPropertyValue('row-gap'));
    if (!rowHeight || Number.isNaN(rowHeight)) return;

    items.forEach((item) => {
      if (item.classList.contains('hidden')) {
        item.style.gridRowEnd = '';
        return;
      }
      const content = item.querySelector<HTMLElement>('.masonry-content');
      if (!content) return;
      const height = content.getBoundingClientRect().height;
      const span = Math.ceil((height + rowGap) / (rowHeight + rowGap));
      item.style.gridRowEnd = `span ${Math.max(1, span)}`;
    });
  }

  function relayoutMasonrySoon() {
    requestAnimationFrame(layoutMasonry);
  }

  function updateShowMoreButton() {
    if (!showMoreBtn) return;
    const hasMore = Array.from(items).some(
      (item) => itemMatchesFilter(item) && item.classList.contains('paged-out')
    );
    showMoreBtn.hidden = !hasMore;
    if (galleryFade) {
      galleryFade.classList.toggle('opacity-100', hasMore);
      galleryFade.classList.toggle('opacity-0', !hasMore);
      galleryFade.hidden = !hasMore;
    }
  }

  function resetForFilter() {
    let shown = 0;
    items.forEach((item) => {
      if (!itemMatchesFilter(item)) {
        item.classList.add('hidden', 'filtered-out');
        item.classList.remove('paged-out');
        return;
      }

      item.classList.remove('filtered-out');
      if (shown < PAGE_SIZE) {
        item.classList.remove('hidden', 'paged-out');
        shown++;
      } else {
        item.classList.add('hidden', 'paged-out');
      }
    });

    updateShowMoreButton();
    refreshLightbox();
    relayoutMasonrySoon();
  }

  function revealMore() {
    let revealed = 0;
    items.forEach((item) => {
      if (revealed >= PAGE_SIZE) return;
      if (item.classList.contains('filtered-out')) return;
      if (item.classList.contains('paged-out')) {
        item.classList.remove('hidden', 'paged-out');
        revealed++;
      }
    });
    updateShowMoreButton();
    refreshLightbox();
    relayoutMasonrySoon();
  }

  if (showMoreBtn) {
    showMoreBtn.addEventListener('click', () => {
      revealMore();
    });
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeFilter = btn.dataset.filter!;

      filterBtns.forEach((b) => {
        b.classList.remove('bg-violet-600', 'border-violet-600', 'text-white', 'active');
        b.classList.add('border-zinc-700', 'text-zinc-400');
      });
      btn.classList.add('bg-violet-600', 'border-violet-600', 'text-white', 'active');
      btn.classList.remove('border-zinc-700', 'text-zinc-400');
      resetForFilter();
    });
  });

  images.forEach((img) => {
    if (!img.complete) {
      img.addEventListener('load', relayoutMasonrySoon);
    }
  });

  window.addEventListener('resize', relayoutMasonrySoon);
  resetForFilter();
</script>
