    </div>
  </main>

  <footer class="border-t border-zinc-800/50 py-8 px-6 text-center text-zinc-600 text-sm">
    <p>© {new Date().getFullYear()} Ben Walker · Built with <a href="https://astro.build" class="hover:text-violet-400 transition-colors">Astro</a></p>
  </footer>
</Layout>

<style>
  .img-error .placeholder-overlay {
    opacity: 1;
  }
  .img-error img {
    opacity: 0;
  }

  .gallery-item.hidden {
    display: none;
  }

  /* PhotoSwipe default styles */
  :root {
    --pswp-bg: #09090b;
  }
</style>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '#gallery',
    children: 'a.gallery-item:not(.hidden)',
    pswpModule: () => import('photoswipe'),
    bgOpacity: 0.95,
    showHideAnimationType: 'zoom',
    padding: { top: 20, bottom: 20, left: 20, right: 20 },
  });

  lightbox.init();

  // Category filtering
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.gallery-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter!;

      filterBtns.forEach(b => {
        b.classList.remove('bg-violet-600', 'border-violet-600', 'text-white', 'active');
        b.classList.add('border-zinc-700', 'text-zinc-400');
      });
      btn.classList.add('bg-violet-600', 'border-violet-600', 'text-white', 'active');
      btn.classList.remove('border-zinc-700', 'text-zinc-400');

      items.forEach(item => {
        const cat = item.dataset.category!;
        if (filter === 'All' || cat === filter) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });

      // Reinitialise lightbox after filtering so it picks up visible items
      lightbox.destroy();
      const newLightbox = new PhotoSwipeLightbox({
        gallery: '#gallery',
        children: 'a.gallery-item:not(.hidden)',
        pswpModule: () => import('photoswipe'),
        bgOpacity: 0.95,
        showHideAnimationType: 'zoom',
        padding: { top: 20, bottom: 20, left: 20, right: 20 },
      });
      newLightbox.init();
    });
  });
</script>
